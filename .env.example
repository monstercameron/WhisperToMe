OPENAI_API_KEY=
# Local alias also supported for the existing project .env:
# openai=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_STATEFUL=true
# Optional. If unset, the app uses the built-in dictation-aware voice assistant prompt.
OPENAI_SYSTEM_PROMPT=
# Response cap. Spoken replies stay brief by prompt; this leaves room for short fenced code blocks.
OPENAI_MAX_OUTPUT_TOKENS=512

# Runtime LLM provider. Keep OpenAI available, or switch to Cerebras for fast Chat Completions.
WHISPERTOME_LLM_PROVIDER=openai
CEREBRAS_API_KEY=
# Local alias also supported for the existing project .env:
# cerebras=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_STATEFUL=true
CEREBRAS_REASONING_EFFORT=low
CEREBRAS_MAX_OUTPUT_TOKENS=512
CEREBRAS_TIMEOUT_SECONDS=20
CEREBRAS_MAX_RETRIES=0

# Model artifacts
WHISPERTOME_STT_BACKEND=qai_whisper
WHISPERTOME_STT_MODEL_PATH=models/qai/whisper_small/snapdragon_x2_elite/precompiled_qnn_onnx/extracted/whisper_small-precompiled_qnn_onnx-float-qualcomm_snapdragon_x2_elite
WHISPERTOME_STT_LANGUAGE=en
WHISPERTOME_STT_MAX_TOKENS=64
# Used by the older whisper_onnx backend. qai_whisper uses Qualcomm's compiled artifact.
WHISPERTOME_STT_ONNX_VARIANT=fp32
# Prompt used as prior context by the older whisper_onnx backend.
WHISPERTOME_STT_PROMPT=Casual spoken voice assistant commands and dictation. Transcribe the exact words, including slang, profanity, sexual words, unusual phrases, names, and homophones.
WHISPERTOME_PRE_ROLL_MS=600
WHISPERTOME_SPEECH_END_MS=1200
WHISPERTOME_TTS_MODEL_PATH=models/kokoro/kokoro-v1.0.onnx
WHISPERTOME_TTS_VOICE_PATH=models/kokoro/voices-v1.0.bin
WHISPERTOME_TTS_VOICE=af_bella
WHISPERTOME_TTS_LANGUAGE=en-us
WHISPERTOME_TTS_SPEED=1.0

# Runtime policy: no CPU or GPU fallback is allowed.
WHISPERTOME_PROVIDER_ORDER=directml,qnn_htp
# Optional per-model runtime order. Useful when STT and TTS need different NPU providers.
WHISPERTOME_STT_PROVIDER_ORDER=directml,qnn_htp
WHISPERTOME_TTS_PROVIDER_ORDER=directml,qnn_htp

# DirectML is accepted only when you explicitly identify the selected adapter as NPU-backed.
# Until a Windows API verifier is implemented, leave this unset unless you have verified it externally.
WHISPERTOME_DIRECTML_NPU_CONFIRMED=false
WHISPERTOME_DIRECTML_DEVICE_ID=0
WHISPERTOME_DIRECTML_ADAPTER_NAME=

# Wake phrase detection over continuous VAD-gated Whisper transcripts.
# Comma-separated. Can also be overridden with repeated `--wake` CLI flags.
WHISPERTOME_WAKE_PHRASES=whisper to me
WHISPERTOME_WAKE_FUZZY_THRESHOLD=0.88
WHISPERTOME_WAKE_WINDOW_WORDS=8
WHISPERTOME_WAKE_COOLDOWN_MS=2500

# Automatically lower other Windows app audio sessions during wake turns.
WHISPERTOME_WAKE_DUCK_VOLUME=true
WHISPERTOME_WAKE_DUCK_VOLUME_PERCENT=25
